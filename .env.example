# ── JWT 密钥（生产必填） ──
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# ── 默认账号密码（可选） ──
# admin = 管理员（单人账号，可上传更新价格）
# guest = 统一访客账号（多人共用，仅查询）
ADMIN_PASSWORD=etton2026
GUEST_PASSWORD=visit20260703

# ── 密码过期天数（可选，默认 30） ──
PASSWORD_EXPIRY_DAYS=30
