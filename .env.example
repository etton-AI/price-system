# ============================================
# FBA 比价查询系统 — 环境变量
# ============================================
# 复制此文件为 .env.local 并填入实际值

# ── JWT 密钥（必填，用于签发和验证登录令牌） ──
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# ── 管理员初始密码（选填，默认 admin123） ──
# 首次启动时自动创建 admin 账号，密码取自此变量
ADMIN_PASSWORD=admin123

# ── 页面级 Basic Auth（选填，缺一则跳过保护） ──
# 配置后，访问 /price-query 需要输入此凭据
BASIC_USER=admin
BASIC_PASS=change-me
